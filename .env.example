# --- Server ---
PORT=3000
NODE_ENV=development
# Public URL of the React frontend (used for CORS and QR-code URLs)
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cpds?schema=public"

# --- Auth --- (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# --- Rate limiting (requests per IP per minute) ---
RATE_LIMIT=100
LOGIN_RATE_LIMIT=10

# --- Suspicious-activity thresholds (used from Phase 9) ---
# Scan-count risk model: count < MEDIUM -> LOW risk (GENUINE); count >= MEDIUM -> MEDIUM risk (SUSPICIOUS);
# count >= HIGH -> HIGH risk (SUSPICIOUS). Matches the spec's example: 0-2 LOW, 3-5 MEDIUM, 6+ HIGH.
VERIFICATION_MEDIUM_THRESHOLD=3
VERIFICATION_HIGH_THRESHOLD=6
